# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and is never sent to the browser.

# Africa's Talking credentials
AT_USERNAME=sandbox
AT_API_KEY=your_api_key_here

# "sandbox" while testing, "production" once you're ready to send real SMS
AT_ENV=sandbox

# Optional: your approved alphanumeric Sender ID / shortcode.
# Leave blank to use Africa's Talking's default sandbox/test sender.
AT_SENDER_ID=

# Optional: country calling code (no "+") used to expand local numbers
# typed like 07xxxxxxxx into full international format. Default is Kenya.
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=254
